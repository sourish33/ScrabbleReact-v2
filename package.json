{
  "name": "scrabble-react-optimized",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "bootstrap": "^5.3.0",
    "react": "^18.3.1",
    "react-bootstrap": "^2.0.0",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.11.0",
    "sweetalert2": "^11.1.0"
  },
  "scripts": {
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "process-dictionary": "node scripts/processDictionary.js",
    "update-sw-version": "node scripts/updateServiceWorkerVersion.js",
    "prebuild": "npm run process-dictionary && npm run update-sw-version"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "gh-pages": "^3.2.3",
    "jsdom": "^25.0.1",
    "vite": "^5.4.11",
    "vitest": "^1.6.0"
  }
}
